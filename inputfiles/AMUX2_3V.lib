

library(AMUX2_3V) {

  delay_model              : table_lookup;
  time_unit                : "1ns";
  voltage_unit             : "1V";
  current_unit             : "1mA";
  leakage_power_unit       : "1nW";
  capacitive_load_unit (1, pf);

  cell(AMUX2_3V) {

    area : 300;

    pin(I0) {
      direction    : input;
      capacitance  : 0.002;
    }

    pin(I1) {
      direction    : input;
      capacitance  : 0.002;
    }

    pin(select) {
      direction    : input;
      capacitance  : 0.001;
    }

    pin(out) {
      direction : output;
      function  : "(select * I1) + (!select * I0)";

      timing() {
        related_pin : "I0";
        timing_type : combinational;

        cell_rise(scalar) {
          values("0.15");
        }

        cell_fall(scalar) {
          values("0.15");
        }

        rise_transition(scalar) {
          values("0.05");
        }

        fall_transition(scalar) {
          values("0.05");
        }
      }

      timing() {
        related_pin : "I1";
        timing_type : combinational;

        cell_rise(scalar) {
          values("0.15");
        }

        cell_fall(scalar) {
          values("0.15");
        }

        rise_transition(scalar) {
          values("0.05");
        }

        fall_transition(scalar) {
          values("0.05");
        }
      }

      timing() {
        related_pin : "select";
        timing_type : combinational;

        cell_rise(scalar) {
          values("0.08");
        }

        cell_fall(scalar) {
          values("0.08");
        }

        rise_transition(scalar) {
          values("0.03");
        }

        fall_transition(scalar) {
          values("0.03");
        }
      }
    }

  }

}

